  const [st42,obs42]=rel_desp_lb<=95?["BOM","Despesas controladas (≤95% do LB)"]:
    rel_desp_lb<=110?["REGULAR","Despesas levemente acima — monitorar"]:
    rel_desp_lb<=150?["ATENÇÃO","Despesas comprometem resultado — risco de até 5 pts FM"]:
    ["CRÍTICO","Despesas muito acima do LB — risco de INCONSISTÊNCIA FACTS + inelegibilidade"];
