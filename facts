    serv_lb_pct>=20?["REGULAR",`Margem Serviços ${P(serv_lb_pct)} — IRC pode estar abaixo do objetivo regional`]:
    serv_lb_pct>=5?["ATENÇÃO",`Margem Serviços ${P(serv_lb_pct)} — risco de 0-3 pts no IRC`]:
    ["CRÍTICO",`Margem Serviços ${P(serv_lb_pct)} — possível prejuízo em serviços`];
  avs.push({criterio:"3.2 IRC + Passagens Totais",pts_max:5,
    valor:P(serv_lb_pct),status:st32,obs:obs32,
    acao:"Aumentar passagens V1; crescer ≥4% vs 2025 para +2 pts; agrupar por AOP até 31/05; acompanhar base 2025 com o GNV"});

  // 3.3 Acessórios
  const [st33,obs33]=fi_lb_mes>100000?["BOM","F&I com LB positivo — TKM provavelmente adequado"]:
    fi_lb_mes>0?["REGULAR","F&I positivo mas baixo — TKM pode estar abaixo do objetivo"]:
    ["CRÍTICO","F&I negativo — risco de 0 pts em Acessórios; TKM mínimo R$830 para elegibilidade"];
  avs.push({criterio:"3.3 Acessórios Chevrolet (TKM)",pts_max:5,
    valor:`F&I LB: ${BRL(fi_lb_mes)}`,status:st33,obs:obs33,
    acao:"TKM mínimo R$830/veículo; crescer ≥10% vs 2025 = 3 pts; regularidade ≥80%/trimestre = +1 pt; foco em S10, Montana, Tracker"});

  // 4.1 Linha de Crédito
  const [st41,obs41]=cap_giro>500000?["BOM",`Capital de giro ${BRL(cap_giro)} — linha provavelmente adequada`]:
