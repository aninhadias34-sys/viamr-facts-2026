    rel_desp_lb>130?["ATENÇÃO","Verificar consistência com Planejamento Estratégico da Rede"]:
    ["BOM","FACTS provavelmente consistente — manter pontualidade de envio"];
  avs.push({criterio:"4.3 Consistência Relatório FACTS",pts_max:5,
    valor:rel_desp_lb>200?"RISCO":rel_desp_lb>130?"ATENÇÃO":"OK",status:st43,obs:obs43,
