import { useState, useCallback } from "react";
import * as XLSX from "xlsx";

// ── Paleta ────────────────────────────────────────────
const C = {
  dark:"1F3864", med:"2E74B5", lite:"D6E4F0", gray:"F2F2F2", white:"FFFFFF",
  red_bg:"FFDCE0", red_fg:"C00000", yel_bg:"FFF2CC", yel_fg:"7F6000",
  grn_bg:"E2EFDA", grn_fg:"375623", ora_bg:"FCE4D6", ora_fg:"843C0C",
};

const CODES  = ["DD","JU","MB","PB","SP"];
const NOMES  = {DD:"DIADEMA",JU:"NAÇÕES UNIDAS",MB:"MORUMBI",PB:"PEREIRA BARRETO",SP:"ANHAIA MELLO"};

// ── Helpers XLSX builder ──────────────────────────────
const fl = h => ({patternType:"solid", fgColor:{rgb:h}});
const fn = (bold,color="000000",sz=9) => ({name:"Arial",bold:!!bold,color:{rgb:color},sz});
const al = (h="left",wrap=false) => ({horizontal:h,vertical:"center",wrapText:wrap});
const bdr = () => { const s={style:"thin",color:{rgb:"BFBFBF"}}; return{left:s,right:s,top:s,bottom:s}; };

function cv(v,fmt,bgHex,bold,fc="000000",hAlign="left",wrap=false){
  const isNeg = typeof v==="number"&&v<0;
  return {v, t:typeof v==="number"?"n":"s", s:{
    font:fn(bold, fc||(isNeg?"C00000":"000000")),
    fill:fl(bgHex||"FFFFFF"),
    alignment:al(hAlign,wrap),
    numFmt:fmt||"General",
    border:bdr()
  }};
}
function ch(v,bgHex,wrap=true){
  return {v,s:{font:fn(true,"FFFFFF"),fill:fl(bgHex||"1F3864"),alignment:al("center",wrap),border:bdr()}};
}
function cs(v,bgHex){
  return {v,s:{font:fn(true,"FFFFFF"),fill:fl(bgHex||"2E74B5"),alignment:al("left"),border:bdr()}};
}

function addSheet(wb,name,rows,colWidths){
  const ws={};let maxC=0;
  rows.forEach((row,ri)=>{
    if(!row)return;
    row.forEach((cell,ci)=>{
      if(cell===undefined||cell===null)return;
      const addr=XLSX.utils.encode_cell({r:ri,c:ci});
      ws[addr]=typeof cell==="object"&&cell.v!==undefined?cell:{v:cell};
      if(ci>maxC)maxC=ci;
    });
  });
  ws["!ref"]=XLSX.utils.encode_range({s:{r:0,c:0},e:{r:rows.length-1,c:maxC}});
  if(colWidths) ws["!cols"]=colWidths.map(w=>({wch:w}));
  XLSX.utils.book_append_sheet(wb,ws,name);
}

// ── Leitura das sheets ────────────────────────────────
function getRows(wb,name,maxRow=120){
  if(!wb.Sheets[name])return [];
  return XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,defval:null,raw:true,
    range:{s:{r:0,c:0},e:{r:maxRow,c:30}}});
}
const nv=(rows,r,c)=>{
  if(!rows[r]||rows[r][c]==null)return 0;
  const v=rows[r][c]; return typeof v==="number"?v:0;
};

// ── Extração dos dados FACTS ──────────────────────────
function extractFACTS(code,wb){
  const p2=getRows(wb,"Page2",70);
  const p6=getRows(wb,"Page6",70);
  const p7=getRows(wb,"Page7",115);
  const p1=getRows(wb,"Page1",70);

  const vl_ytd=nv(p2,3,9),  lb_ytd=nv(p2,4,9);
  const vl_mes=nv(p2,3,6),   lb_mes=nv(p2,4,6);
  const desp_ytd=nv(p2,59,9),desp_mes=nv(p2,59,6);
  const ll_ytd=nv(p2,67,9),  ll_mes=nv(p2,67,6);
  const lo_mes=nv(p2,60,6),  lo_ytd=nv(p2,60,9);

  const rel_desp_lb=lb_ytd!==0?desp_ytd/lb_ytd*100:0;
  const lb_pct_ytd=vl_ytd?lb_ytd/vl_ytd*100:0;
  const lb_pct_mes=vl_mes?lb_mes/vl_mes*100:0;

  const pec_vl=nv(p6,64,6), pec_lb=nv(p6,64,8);
  const pec_lb_pct=pec_vl?pec_lb/pec_vl*100:0;
  const mec_vl=nv(p6,36,6), mec_lb=nv(p6,36,8);
  const fun_vl=nv(p6,45,6), fun_lb=nv(p6,45,8);
  const serv_vl=nv(p6,46,6),serv_lb=nv(p6,46,8);
  const serv_lb_pct=serv_vl?serv_lb/serv_vl*100:0;
  const us_var_unid=nv(p6,9,5),us_var_vl=nv(p6,9,6),us_var_lb=nv(p6,9,8);
  const us_lb_pct=us_var_vl?us_var_lb/us_var_vl*100:0;

  const hc_total=nv(p7,48,14);
  const fi_rec_mes=nv(p7,21,5),fi_lb_mes=nv(p7,21,7),fi_rec_ytd=nv(p7,21,10);
  const rec_total=nv(p7,59,8),rec_mais90=nv(p7,59,14);
  const rec_m90_pct=rec_total?rec_mais90/rec_total*100:0;
  const cap_giro=nv(p1,46,9);
  const total_ativos=nv(p1,67,8);

  return {code,nome:`VIAMAR ${NOMES[code]}`,
    vl_mes,vl_ytd,lb_mes,lb_ytd,lb_pct_mes,lb_pct_ytd,
    desp_mes,desp_ytd,ll_mes,ll_ytd,lo_mes,lo_ytd,
    rel_desp_lb,pec_vl,pec_lb,pec_lb_pct,
    mec_vl,mec_lb,fun_vl,fun_lb,serv_vl,serv_lb,serv_lb_pct,
    us_var_unid,us_var_vl,us_var_lb,us_lb_pct,
    hc_total,fi_rec_mes,fi_lb_mes,fi_rec_ytd,
    rec_total,rec_mais90,rec_m90_pct,cap_giro,total_ativos
  };
}

// ── Avaliação por critério (cartilha FM 2026) ─────────
const BRL=v=>v<0?`(${Math.abs(v).toLocaleString("pt-BR",{style:"currency",currency:"BRL",maximumFractionDigits:0})})`:v.toLocaleString("pt-BR",{style:"currency",currency:"BRL",maximumFractionDigits:0});
const P=v=>v.toFixed(1)+"%";

